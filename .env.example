OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 문서 색인과 검색에 동일한 모델·차원을 사용한다. 변경하면 rag-index를 다시 실행한다.
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536
# JWT 서명 키 (32바이트 이상). 비워 두면 compose의 시연용 기본값을 쓴다
JWT_SECRET=
# /internal 서비스 토큰 (비워 두면 compose의 시연용 기본값)
AGENT_SERVICE_TOKEN=
BUSINESS_MCP_SERVICE_TOKEN=
