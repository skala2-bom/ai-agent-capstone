OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# fake는 키가 있어도 LLM을 호출하지 않는다. 비용 0 검증용.
AGENT_MODEL_MODE=auto
FALLBACK_MODEL=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=bom-agent-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=
AGENT_INPUT_TOKEN_BUDGET=12000
AGENT_OUTPUT_MAX_TOKENS=1500
TOOL_RESULT_MAX_CHARS=4000
MAX_ADJUST_TURNS=64
AGENT_WORK_TIMEOUT_S=600
AGENT_RECURSION_LIMIT=600
# 문서 색인과 검색에 동일한 모델·차원을 사용한다. 변경하면 rag-index를 다시 실행한다.
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536
# JWT 서명 키 (32바이트 이상). 비워 두면 compose의 시연용 기본값을 쓴다
JWT_SECRET=
# /internal 서비스 토큰 (비워 두면 compose의 시연용 기본값)
AGENT_SERVICE_TOKEN=
BUSINESS_MCP_SERVICE_TOKEN=
